# Adresa katalogu hřišť (golfgames-courses). Prázdná = publikovaný katalog.
VITE_COURSES_URL=

# Id turnajového dokumentu ve Firestore. Prázdné = turecko-cup-26.
VITE_TOURNAMENT_ID=

# Konfigurace Firebase (Firebase Console -> Project settings -> Web app).
# Údaje nejsou tajné, zabezpečení stojí na firestore.rules. Bez nich aplikace
# běží v místním režimu: data jen v prohlížeči, bez přihlášení.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
