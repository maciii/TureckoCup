{
  "name": "turecko-cup",
  "version": "0.18.0",
  "description": "Turecko Cup 26 - turnajová golfová aplikace pro 8 hráčů: živý zápis skóre, týmové i individuální vyhodnocení, veřejný leaderboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/bump-version.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:firebase": "firebase emulators:exec --only firestore,auth --project demo-tc26 \"playwright test -c playwright.firebase.config.ts\"",
    "test:e2e:live": "playwright test -c playwright.live.config.ts",
    "test:e2e:install": "playwright install chromium",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run test && npm run format:check",
    "bump:minor": "node scripts/bump-version.mjs minor",
    "bump:major": "node scripts/bump-version.mjs major",
    "test:rules": "firebase emulators:exec --only firestore --project tc26-rules-test \"node --test rules/firestore.rules.test.mjs\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maciii/TureckoCup.git"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "firebase": "^12.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.32.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
