rules_version = '2';

// Pravidla zabezpečení Firestore pro Turecko Cup 26.
//
// Tři role:
//   Visitor  čte všechno veřejné bez přihlášení (turnaj, hráči, kola)
//   Hráč     přihlášený Googlem s e-mailem hráče v private/access.playerEmails;
//            smí měnit jen jednu buňku skóre/bonusů/dublů na jeden zápis v kole,
//            které není uzavřené
//   Admin    e-mail v private/access.adminEmails nebo bootstrap e-mail níž;
//            smí vše
// Nikdo jiný přihlášený nesmí nic víc než visitor.
//
// E-maily leží v tournaments/{tid}/private/access (čtou ho hráči a admin -
// klient z něj pozná, kdo se přihlásil) a v logu úprav (byEmail, čte jen
// admin). get() v pravidlech čtecí omezení obchází, takže whitelist funguje.
//
// Nasazení: workflow Build & Deploy (firebase deploy --only firestore:rules)
// před nasazením aplikace; ručně Firebase Console -> Firestore -> Rules.
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Google ověřuje adresu už při založení účtu, ale u účtů s cizí adresou
    // (seznam.cz) Firebase email_verified nenastaví. Aplikace jiné přihlášení
    // než Googlem nenabízí, proto Googlu věříme i bez příznaku.
    function verified() {
      return signedIn()
        && (request.auth.token.email_verified == true
            || request.auth.token.firebase.sign_in_provider == 'google.com');
    }

    function email() {
      return request.auth.token.email.lower();
    }

    function accessPath(tid) {
      return /databases/$(db)/documents/tournaments/$(tid)/private/access;
    }

    function access(tid) {
      return get(accessPath(tid)).data;
    }

    // Bootstrap e-mail řeší slepici a vejce: při založení turnaje dokument
    // private/access ještě neexistuje. `||` toleruje chybu na jedné straně.
    function isAdmin(tid) {
      return verified()
        && (email() == 'mac.kubecka@gmail.com'
            || (exists(accessPath(tid)) && email() in access(tid).adminEmails));
    }

    // Hráč = ověřený Google e-mail přiřazený některému hráči soupisky.
    function isPlayer(tid) {
      return verified()
        && exists(accessPath(tid))
        && email() in access(tid).get('playerEmails', {}).values();
    }

    function isWriter(tid) {
      return isAdmin(tid) || isPlayer(tid);
    }

    // 0 = zvednutá jamka, jinak rány. Chybějící klíč = nezapsáno.
    function validStrokes(v) {
      return v is int && v >= 0 && v <= 20;
    }

    // Jeden zápis = jedna buňka (hráč × jamka) ve skóre a případně v bonusech,
    // a k tomu lastEdit, který říká, která buňka to je. Kontroluje se i vnořená
    // úroveň, jinak by šlo jedním zápisem přepsat celou mapu skóre.
    function validScoreEdit() {
      let before = resource.data;
      let after = request.resource.data;
      let e = after.lastEdit;
      let p = e.playerId;
      let h = e.hole;
      return before.status != 'finished'
        && after.diff(before).affectedKeys().hasOnly(['scores', 'bonuses', 'doubles', 'lastEdit'])
        && e.keys().hasOnly(['playerId', 'hole', 'by', 'at'])
        && e.by == request.auth.uid
        && e.at == request.time
        && p in before.playerIds
        && h.matches('^([0-9]|1[0-7])$')
        && after.scores.diff(before.scores).affectedKeys().hasOnly([p])
        && after.scores[p].diff(before.scores[p]).affectedKeys().hasOnly([h])
        && (!(h in after.scores[p]) || validStrokes(after.scores[p][h]))
        && validBonusEdit(before, after, p, h)
        && validDoubleEdit(before, after, p, h);
    }

    // Dubly Four-ball Skins: stejná buňka hráč × jamka jako bonusy (seznam id her).
    function validDoubleEdit(before, after, p, h) {
      let b = before.get('doubles', {});
      let a = after.get('doubles', {});
      return a.diff(b).affectedKeys().hasOnly([p])
        && a.get(p, {}).diff(b.get(p, {})).affectedKeys().hasOnly([h])
        && (!(h in a.get(p, {}))
            || (a[p][h] is list && a[p][h].size() <= 8));
    }

    // Mapa bonusů nemusí v kole existovat (kola založená před extra body) -
    // `get` s výchozí prázdnou mapou, jinak by zápis skóre hráče spadl.
    function validBonusEdit(before, after, p, h) {
      let b = before.get('bonuses', {});
      let a = after.get('bonuses', {});
      return a.diff(b).affectedKeys().hasOnly([p])
        && a.get(p, {}).diff(b.get(p, {})).affectedKeys().hasOnly([h])
        && (!(h in a.get(p, {}))
            || (a[p][h] is list && a[p][h].size() <= 8));
    }

    match /tournaments/{tid} {
      allow read: if true;
      allow write: if isAdmin(tid);

      match /private/{doc} {
        allow read: if isAdmin(tid) || isPlayer(tid);
        allow write: if isAdmin(tid);
      }

      match /players/{pid} {
        allow read: if true;
        allow write: if isAdmin(tid);
      }

      match /rounds/{rid} {
        allow read: if true;
        allow create, delete: if isAdmin(tid);
        allow update: if isAdmin(tid) || (isWriter(tid) && validScoreEdit());

        // Log úprav skóre: jen přidávání, nikdy změna ani mazání. Nese e-mail
        // zapisovatele, proto ho čte jen admin. E-mail nejde podvrhnout.
        match /edits/{eid} {
          allow read: if isAdmin(tid);
          allow create: if isWriter(tid)
            && request.resource.data.by == request.auth.uid
            && request.resource.data.at == request.time
            && (!('byEmail' in request.resource.data)
              || request.resource.data.byEmail == email());
          allow update, delete: if false;
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
